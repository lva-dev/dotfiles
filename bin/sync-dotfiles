#!/usr/bin/env bash

THIS_FILE_PATH="$(readlink -f "$0")"
THIS_FILE_BASENAME="$(basename "$THIS_FILE_PATH")"

function status() {
  echo -e "$THIS_FILE_BASENAME: \e[33mstatus\e[m: $1"
}

function error() {
  echo -e "$THIS_FILE_BASENAME: \e[31merror\e[m: $1" >&2
}

echo "$THIS_FILE_PATH"
cd "$(dirname "$(dirname "$THIS_FILE_PATH")")" || exit 2

status "stashing local dotfiles repository changes..."
stash_result="$(git stash push -m "$THIS_FILE_BASENAME: Stash before syncing dotfiles")"
needs_pop=1
if [ "$stash_result" = "No local changes to save" ]; then
    needs_pop=0
fi

status "pulling changes from dotfiles repository..."
if ! git pull; then
  error "git failed to pull dotfiles from dotfiles repository"
  exit 1
fi

if [[ $needs_pop -eq 1 ]]; then
    status "${BLUE}popping stashed changes...${NC}"
    git stash pop
fi

unmerged_files=$(git diff --name-only --diff-filter=U)
if [[ ! -z $unmerged_files ]]; then
   error "the following files have merge conflicts after popping the stash:"
   printf "%s\n" $unmerged_files  Ensure newlines are printed
else
   stow .
fi
